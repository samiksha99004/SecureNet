# ============================================================
# SecureNet Frontend — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in actual values
# when the backend is ready.
#
# DO NOT commit .env.local to version control.
# ============================================================

# Base URL for the SecureNet REST API (set by backend developer)
VITE_API_BASE_URL=http://localhost:8000/api

# WebSocket URL for live monitoring feed (set by backend developer)
VITE_WS_URL=ws://localhost:8000/ws

# Application environment: development | production
VITE_APP_ENV=development

# Application display name
VITE_APP_NAME=SecureNet
