# ═══════════════════════════════════════════════════════════════════════════
# SecureNet Backend — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Application ────────────────────────────────────────────────────────────
APP_NAME=SecureNet
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://securenet:your_secure_password@localhost:5432/securenet
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Authentication ─────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── OTP Configuration ──────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ── Email (for OTP delivery) ───────────────────────────────────────────────
# For development, OTPs can be logged instead of emailed
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=securenet@example.com
SMTP_FROM_NAME=SecureNet

# ── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── ML Models ──────────────────────────────────────────────────────────────
ML_MODELS_DIR=./models
ISOLATION_FOREST_MODEL_PATH=./models/isolation_forest.joblib
XGBOOST_MODEL_PATH=./models/xgboost_classifier.joblib
FEATURE_SCALER_PATH=./models/feature_scaler.joblib
FEATURE_COUNT=78

# ML Thresholds
ANOMALY_THRESHOLD=0.5
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7

# ── Detection Settings ─────────────────────────────────────────────────────
DETECTION_ENABLED=true
DETECTION_MODE=monitor
ANALYSIS_INTERVAL_SECONDS=5
MIN_FLOWS_FOR_ANALYSIS=10

# ── WebSocket ──────────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30
WS_MESSAGE_QUEUE_SIZE=1000

# ── Redis (for background tasks & caching) ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/securenet.log

# ── Reports ────────────────────────────────────────────────────────────────
REPORTS_DIR=./reports
MAX_REPORT_SIZE_MB=50

# ── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ── Security ───────────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
