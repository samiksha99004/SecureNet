# ═══════════════════════════════════════════════════════════════════════════
# SecureNet Backend — Environment Configuration Template
# Copy to .env and fill in real values. NEVER commit .env.
# Relative paths are resolved against the backend/ folder.
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────────
APP_NAME=SecureNet
DEBUG=false                 # true enables /api/docs and detailed 500 messages
ENVIRONMENT=production

# ── Database (PostgreSQL via asyncpg) ──────────────────────────────────────
# Cloud PostgreSQL only (local databases are refused). Neon connection string with the +asyncpg driver:
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/neondb?ssl=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# ── Authentication ─────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ── Accounts ──────────────────────────────────────────────────────────────
# Emails that become ADMIN when they register (comma-separated); everyone else is a
# normal user. Empty = the first account to register becomes admin.
ADMIN_EMAILS=

# ── CORS (comma-separated origins of the frontend) ─────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── OTP / Email ────────────────────────────────────────────────────────────
# Used for OTP codes AND attack alert emails (sent to every registered user).
# Emails are never faked: with EMAIL_ENABLED=false (or placeholder credentials) nothing is sent and
# sign-up is refused until SMTP works.
# Gmail: SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-char App Password>
#        (Google Account → Security → 2-Step Verification → App passwords).
#        For Gmail set SMTP_FROM_EMAIL to the same address as SMTP_USER.
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=            # empty = same as SMTP_USER
SMTP_FROM_NAME=SecureNet
# Alerts are grouped for this many seconds into one email per recipient
ALERT_EMAIL_BATCH_SECONDS=30
ALERT_EMAIL_MAX_EVENTS=50
# Link used in alert emails
DASHBOARD_URL=http://localhost:5173

# ── ML models (optional) ───────────────────────────────────────────────────
# false = no model is loaded; the IDS captures traffic but does not score it.
# true  = load Isolation Forest and/or XGBoost from ML_MODELS_DIR at startup
#         (requires: pip install -r requirements-ml.txt).
ML_AUTOLOAD=false
ML_MODELS_DIR=./models

# Defaults until changed on the Settings page
ANOMALY_THRESHOLD=0.5
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
DETECTION_MODE=monitor      # monitor (Detection) | protect (Protection)

# ── Packet capture ─────────────────────────────────────────────────────────
# Windows needs Npcap (https://npcap.com) and an Administrator backend.
CAPTURE_INTERFACE=          # empty = default interface
FLOW_IDLE_TIMEOUT_SECONDS=15
FLOW_ACTIVE_TIMEOUT_SECONDS=120
LIVE_SCORE_MAX_PER_SECOND=20

# ── Misc ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
REPORTS_DIR=./reports
# Serve a built frontend from the backend (used by the Electron shell)
FRONTEND_DIST=

# ── IDS stays on after a restart ───────────────────────────────────────────
# While the IDS is ON its state is saved and "SecureNet Monitor" is added to the
# Windows Startup folder; after the computer restarts the IDS turns itself back
# on and one desktop notification says "SecureNet is on and is monitoring."
IDS_AUTOSTART=true
IDS_STATE_FILE=./data/ids-state.json
# Empty = this user's Windows Startup folder
IDS_STARTUP_DIR=
DESKTOP_NOTIFICATIONS=true
